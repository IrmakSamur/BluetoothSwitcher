<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BluetoothSwitcher.App</RootNamespace>
    <AssemblyName>BluetoothSwitcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon of the exe (Explorer, Start menu shortcut). Regenerate with tools\New-AppIcon.ps1. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: a plain exe, no MSIX. The Windows App SDK ships next to it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BluetoothSwitcher.Core\BluetoothSwitcher.Core.csproj" />
  </ItemGroup>

  <!-- The switching engine (two-phase stop), copied unchanged next to the exe as Switch-Adapter.ps1. -->
  <ItemGroup>
    <Content Include="..\..\poc\Switch-Adapter-Next.ps1" Link="Switch-Adapter.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Also shipped as a file: the window (title bar and taskbar) loads its icon from it. -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Embed the script's SHA-256 in the assembly. The app refuses to start any
       script elevated whose hash differs (see Engine in App.xaml.cs). -->
  <Target Name="EmbedSwitchScriptHash" BeforeTargets="GetAssemblyAttributes">
    <GetFileHash Files="..\..\poc\Switch-Adapter-Next.ps1" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="SwitchScriptSha256" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="SwitchScriptSha256" Value="$(SwitchScriptSha256)" />
    </ItemGroup>
  </Target>

</Project>
